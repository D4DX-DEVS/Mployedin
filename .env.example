# ─────────────────────────────────────────────────────────────────────────────
# Online payments (Stripe or Razorpay) — see docs/PAYMENTS.md
#
# Leave PAYMENT_PROVIDER unset (or "manual") to keep manual billing: checkout
# shows the "Request upgrade" dialog and invoices are paid by bank transfer.
# Pick ONE provider and fill its block. Start with TEST keys.
# ─────────────────────────────────────────────────────────────────────────────

# PAYMENT_PROVIDER=stripe            # stripe | razorpay | manual
# DEFAULT_CURRENCY=AED               # fallback currency for refunds / admin display
# PAYMENT_PAST_DUE_GRACE_DAYS=7      # access kept after an unpaid renewal (0–60)
# NEXT_PUBLIC_APP_URL=https://app.example.com   # used for return URLs + webhook URL

# ── Stripe (Dashboard → Developers → API keys / Webhooks) ────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Razorpay (Dashboard → Account & Settings → API Keys / Webhooks) ──────────
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
