{
    "typescript.tsdk":  "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk":  true,
    "typescript.tsserver.watchOptions":  {
                                             "excludeDirectories":  [
                                                                        "**/node_modules/**",
                                                                        "**/.next/**"
                                                                    ]
                                         },
    "search.exclude":  {
                           "**/node_modules":  true,
                           "**/.next":  true
                       },
    "files.watcherExclude":  {
                                 "**/node_modules/**":  true,
                                 "**/.next/**":  true
                             },
    "kiroAgent.configureMCP":  "Disabled"
}
